PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gym-management
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Frontend origin(s) — comma-separated if you have more than one (e.g. local +
# deployed). Used for CORS allow-listing and for building password-reset links.
CLIENT_URL=http://localhost:5173

# Optional — AI Fitness Assistant (workout/diet/BMI/prediction/chat generation)
# Without this, the app still runs; AI endpoints return a graceful 503
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
AI_MODEL=claude-opus-5

# Optional — outgoing email (expiry reminders, booking confirmations,
# password reset, contact form, announcements)
# Without these, emails are silently skipped; in-app notifications still work
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — where contact-form submissions are emailed. Falls back to
# SMTP_FROM/SMTP_USER if unset.
ADMIN_NOTIFICATION_EMAIL=

# Optional — Razorpay payment gateway (test or live key pair from your
# Razorpay dashboard). Without these, checkout gracefully returns a 503 and
# the app falls back to the always-available demo/offline payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — membership expiry-reminder cron
# EXPIRY_REMINDER_DAYS: notify members this many days before expiry (default 3)
# MEMBERSHIP_CRON_SCHEDULE: standard cron syntax (default "0 8 * * *" = daily at 08:00)
EXPIRY_REMINDER_DAYS=3
MEMBERSHIP_CRON_SCHEDULE=0 8 * * *
